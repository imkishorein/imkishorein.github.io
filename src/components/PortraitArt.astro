---
// Avatar of Kishore for the stamp: front-facing, flat shapes, three palette tones
// (art colours in tokens.css) so it matches the landscape stamp and never flips in dark mode.
// Drawn from reference photos, as a likeness rather than a trace: side-swept dark hair with
// a high hairline, strong brows, round glasses (dark top rim, silver lower rim, set clear of the brows), short
// moustache with a trimmed goatee, open-collar patterned shirt.
---
<svg class="art" viewBox="0 0 200 240" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Illustrated portrait of Kishore" style="--skin: color-mix(in oklab, var(--art-mid) 52%, var(--art-deep))">
  <defs>
    <pattern id="kv-weave" width="16" height="22" patternUnits="userSpaceOnUse">
      <path d="M4 0 L7 11 L4 22 M12 0 L9 11 L12 22" stroke="var(--art-deep)" stroke-opacity=".55" stroke-width="1.3" fill="none" />
      <path d="M8 7 L10.5 11 L8 15 L5.5 11Z" fill="var(--art-deep)" fill-opacity=".5" />
    </pattern>
    <pattern id="kv-stubble" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="1.2" cy="1.2" r=".55" fill="var(--art-deep)" /><circle cx="3.8" cy="3.5" r=".5" fill="var(--art-deep)" />
    </pattern>
    <clipPath id="kv-face"><path d="M66 90 C66 62 82 50 100 50 C118 50 134 62 134 90 C134 112 128 128 114 137 C108 141 92 141 86 137 C72 128 66 112 66 90Z" /></clipPath>
  </defs>

  <!-- backdrop: sage, a soft halo, warm lights like the cafe photo -->
  <rect width="200" height="240" fill="var(--art-mid)" />
  <circle cx="100" cy="100" r="72" fill="var(--art-light)" opacity=".32" />
  <circle cx="28" cy="52" r="11" fill="var(--art-light)" opacity=".5" /><circle cx="172" cy="40" r="7" fill="var(--art-light)" opacity=".45" />
  <circle cx="176" cy="84" r="4" fill="var(--art-light)" opacity=".4" />

  <!-- shoulders about twice the head width, short wide neck, open camp collar (proportions from the photos) -->
  <g transform="translate(0 -31)">
    <path d="M10 270 V230 C10 208 38 196 72 190 L128 190 C162 196 190 208 190 230 V270Z" fill="var(--art-light)" />
    <path d="M10 270 V230 C10 208 38 196 72 190 L128 190 C162 196 190 208 190 230 V270Z" fill="url(#kv-weave)" />
    <path d="M78 130 V178 C86 188 114 188 122 178 V130Z" fill="var(--skin)" />
    <path d="M78 146 C88 156 112 156 122 146 V178 C114 188 86 188 78 178Z" fill="var(--art-deep)" opacity=".13" />
    <path d="M84 182 L100 210 L116 182Z" fill="var(--skin)" />
    <path d="M84 182 L100 210 L76 204 L60 188 C68 184 76 182 84 182Z" fill="var(--art-light)" stroke="var(--art-deep)" stroke-opacity=".6" stroke-width="1.2" stroke-linejoin="round" />
    <path d="M116 182 L100 210 L124 204 L140 188 C132 184 124 182 116 182Z" fill="var(--art-light)" stroke="var(--art-deep)" stroke-opacity=".6" stroke-width="1.2" stroke-linejoin="round" />
    <path d="M100 210 V270" stroke="var(--art-deep)" stroke-opacity=".5" stroke-width="1.2" />
    <circle cx="100" cy="226" r="2.4" fill="var(--art-mid)" stroke="var(--art-deep)" stroke-opacity=".6" stroke-width=".8" />
  </g>

  <!-- head -->
  <g transform="translate(100 140) scale(1.14) translate(-100 -140)">
    <ellipse cx="65" cy="98" rx="6" ry="10.5" fill="var(--skin)" /><ellipse cx="135" cy="98" rx="6" ry="10.5" fill="var(--skin)" />
    <path d="M65 93 C63 97 63 101 65 104 M135 93 C137 97 137 101 135 104" stroke="var(--art-deep)" stroke-opacity=".35" stroke-width="1.2" fill="none" stroke-linecap="round" />
    <path d="M66 90 C66 62 82 50 100 50 C118 50 134 62 134 90 C134 112 128 128 114 137 C108 141 92 141 86 137 C72 128 66 112 66 90Z" fill="var(--skin)" />
    <!-- a few days of stubble: soft tone plus fine stipple over cheeks, jaw and chin -->
    <g clip-path="url(#kv-face)">
      <path d="M62 102 C68 128 86 143 100 144 C114 143 132 128 138 102 C130 118 116 123 100 123 C84 123 70 118 62 102Z" fill="var(--art-deep)" opacity=".1" />
      <path d="M62 102 C68 128 86 143 100 144 C114 143 132 128 138 102 C130 118 116 123 100 123 C84 123 70 118 62 102Z" fill="url(#kv-stubble)" opacity=".5" />
    </g>

    <!-- hair: volume swept to the right, high hairline, short sides -->
    <path d="M63 90 C54 54 78 30 108 31 C134 32 148 56 137 90 C136 80 133 70 125 63 C112 66 96 65 84 68 C74 72 68 80 63 90Z" fill="var(--art-deep)" />
    <path d="M82 50 C96 39 120 40 132 54 M76 60 C80 54 86 50 92 48" stroke="var(--art-mid)" stroke-opacity=".5" stroke-width="1.8" fill="none" stroke-linecap="round" />

    <!-- brows, sitting clear above the frames -->
    <path d="M72 78 C78 72.5 90 72.5 97 76.5 M103 76.5 C110 72.5 122 72.5 128 78" stroke="var(--art-deep)" stroke-width="3.2" fill="none" stroke-linecap="round" />

    <!-- eyes -->
    <ellipse cx="85" cy="95.5" rx="4.8" ry="3.2" fill="var(--art-light)" opacity=".92" /><ellipse cx="115" cy="95.5" rx="4.8" ry="3.2" fill="var(--art-light)" opacity=".92" />
    <circle cx="85.6" cy="95.5" r="2.5" fill="var(--art-deep)" /><circle cx="115.6" cy="95.5" r="2.5" fill="var(--art-deep)" />
    <circle cx="86.4" cy="94.6" r=".8" fill="var(--art-light)" /><circle cx="116.4" cy="94.6" r=".8" fill="var(--art-light)" />
    <!-- glasses: lens tint and glare, thin dark top rim, silver lower rim, inner rim line, silver bridge and endpieces -->
    <circle cx="84" cy="95" r="14" fill="var(--art-light)" opacity=".13" /><circle cx="116" cy="95" r="14" fill="var(--art-light)" opacity=".13" />
    <path d="M75 92 L83 84.5 L87 84.5 L78.5 94Z M107 92 L115 84.5 L119 84.5 L110.5 94Z" fill="var(--art-light)" opacity=".38" />
    <circle cx="84" cy="95" r="12.4" stroke="var(--art-light)" stroke-opacity=".35" stroke-width=".8" fill="none" /><circle cx="116" cy="95" r="12.4" stroke="var(--art-light)" stroke-opacity=".35" stroke-width=".8" fill="none" />
    <path d="M70 95 A14 14 0 0 1 98 95 M102 95 A14 14 0 0 1 130 95" stroke="var(--art-deep)" stroke-width="2.6" fill="none" stroke-linecap="round" />
    <path d="M70 95 A14 14 0 0 0 98 95 M102 95 A14 14 0 0 0 130 95" stroke="var(--art-light)" stroke-width="2.2" fill="none" stroke-linecap="round" />
    <path d="M98 92 Q100 89.5 102 92" stroke="var(--art-light)" stroke-width="1.8" fill="none" stroke-linecap="round" />
    <path d="M70.5 92.5 L65 91 M129.5 92.5 L135 91" stroke="var(--art-light)" stroke-width="1.8" stroke-linecap="round" />
    <circle cx="70" cy="93" r="1.1" fill="var(--art-deep)" /><circle cx="130" cy="93" r="1.1" fill="var(--art-deep)" />

    <g transform="translate(0 -2)">
    <path d="M100 103 C98.5 109 94.5 112 94 115 C96.5 118 103.5 118 106 115 C105.5 112 101.5 109 100 103" stroke="var(--art-deep)" stroke-opacity=".5" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="97" cy="115.5" r="1" fill="var(--art-deep)" opacity=".6" /><circle cx="103" cy="115.5" r="1" fill="var(--art-deep)" opacity=".6" />
    </g>
    <!-- thin moustache and a separate small goatee, both short-grown rather than solid -->
    <path d="M87.5 123.6 C91 119.6 96.5 119.6 100 121.4 C103.5 119.6 109 119.6 112.5 123.6 C109.6 122.8 106.4 122.8 104 123.6 C102 124 98 124 96 123.6 C93.6 122.8 90.4 122.8 87.5 123.6Z" fill="var(--art-deep)" opacity=".55" />
    <path d="M93 136.4 C96 135 98.4 135.4 100 135.4 C101.6 135.4 104 135 107 136.4 C109.4 139 108.2 142.4 104.4 143.4 C102 143.9 98 143.9 95.6 143.4 C91.8 142.4 90.6 139 93 136.4Z" fill="var(--art-deep)" opacity=".5" />
    <path d="M93 136.4 C96 135 98.4 135.4 100 135.4 C101.6 135.4 104 135 107 136.4 C109.4 139 108.2 142.4 104.4 143.4 C102 143.9 98 143.9 95.6 143.4 C91.8 142.4 90.6 139 93 136.4Z" fill="url(#kv-stubble)" opacity=".6" />
    <!-- clean smile: one light crescent of teeth under a soft lip line, bare skin around it -->
    <path d="M91.4 126 C96 129.2 104 129.2 108.6 126 C107.6 131 104 132.6 100 132.6 C96 132.6 92.4 131 91.4 126Z" fill="var(--art-light)" />
    <path d="M90.4 124.9 C95 127.9 105 127.9 109.6 124.9" stroke="var(--art-deep)" stroke-opacity=".7" stroke-width="1.2" fill="none" stroke-linecap="round" />
    <path d="M93.5 133.6 C97 135.2 103 135.2 106.5 133.6" stroke="var(--art-deep)" stroke-opacity=".18" stroke-width="1.6" fill="none" stroke-linecap="round" />
  </g>
</svg>
