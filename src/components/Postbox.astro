---
// A little hand-drawn Japanese pillar postbox (round body, 〒 plaque, hooded slot) pinned to the bottom-right corner.
// Hover or focus it and the bottom hatch opens and a WhatsApp bubble comes out of it, like a letter picked from the box. Click opens a WhatsApp chat (wa.me deep link).
// The number is a placeholder in src/data/site.ts. Colours are tokens (ink body, sage details), so it follows
// light and dark mode. The motion is off under reduced motion: the open state just shows on hover or focus.
import { site } from '../data/site';
const { number, message } = site.whatsapp;
const href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
---
<a class="postbox" href={href} target="_blank" rel="noopener" aria-label="Drop me a message on WhatsApp" data-sound="thunk" data-sound-hover="ping">
  <span class="postbox__label label" aria-hidden="true">Drop a line</span>
  <span class="box">
  <!-- a paper plane is tossed out of the bottom hatch every 30s and flies off across the page in a random direction. The flight is driven by src/scripts/site.ts (Web Animations). Decorative, and skipped under reduced motion -->
  <span class="planes" aria-hidden="true">
    <svg class="plane" viewBox="0 0 24 16" focusable="false"><path d="M0.6 8 L23.4 1 L18.6 8 L23.4 15 Z" /><path class="fold" d="M0.6 8 L18.6 8" /><g class="dmg"><path d="M0.6 8 L3.2 6.2 L3.6 9.6 L5.6 7.2" /><path d="M9 3.6 L11.2 6.8 L9.8 10.4" /><path d="M15.4 12.6 L17.2 9.4 L19.4 10.8" /><path d="M20.2 3.8 L19 6.2" /></g></svg>
  </span>
  <svg class="art" viewBox="-22 0 116 118" aria-hidden="true" focusable="false">
    <!-- the plinth: a square concrete slab on the ground (the bottom of the viewport) with a round stone ring on top, like the old Japanese postbox photo -->
    <path class="slab-top" d="M-3 98.6 C20 98 52 98 75 98.6 L82 103.6 C50 104.4 24 104.4 -10 103.6 Z" />
    <path class="slab-front" d="M-10 103.6 C24 104.4 50 104.4 82 103.6 L81.6 118 L-9.6 118 Z" />
    <path class="slab-line" d="M-8 111 C20 111.7 52 111.7 80 111" />
    <path class="ring-side" d="M5 90 L4.6 96 C5 101.6 67 101.6 67.4 96 L67 90 Z" />
    <ellipse class="ring-top" cx="36" cy="90" rx="31" ry="5.6" />
    <path class="ring-line" d="M7 96.4 C20 99.6 52 99.6 65 96.4" />

    <!-- a round Japanese pillar postbox: cylinder body, lid, round plaque with the 〒 mark, hooded slot, collar -->
    <path class="body" d="M14.6 22 C14.2 40 15 66 14.6 86 C14.6 87.6 15.8 88.4 17.4 88.4 L55 88.2 C56.6 88.2 57.4 87.2 57.2 85.6 C57.6 66 57 40 57.4 22 Z" />
    <path class="shine" d="M19 26 C18.6 44 19.2 64 18.8 82 L22.6 82 C23 64 22.4 44 22.8 26 Z" />
    <path class="lid" d="M11.4 19.6 C11 11.8 24 8.6 36 8.6 C48 8.6 61 11.8 60.6 19.6 C60.8 22.2 59.4 23.6 57.6 23.8 C46 24.6 26 24.6 14.4 23.8 C12.6 23.6 11.2 22.2 11.4 19.6 Z" />
    <path class="rim" d="M17 17 C24 14.6 48 14.6 55 17" />

    <circle class="plaque" cx="36" cy="46" r="18.4" />
    <circle class="plaque-rim" cx="36" cy="46" r="16.2" />
    <g class="mark" transform="translate(0 1.6)">
      <path d="M27.6 38 C32 37.4 40 37.4 44.4 38 L44.2 40.8 C40 41.4 32 41.4 27.8 40.8 Z" />
      <path d="M25.4 43.2 C31 42.6 41 42.6 46.6 43.2 L46.4 46 C41 46.6 31 46.6 25.6 46 Z" />
      <path d="M34.6 45.6 C35.4 45.4 36.6 45.4 37.4 45.6 L37.6 52 C36.6 52.4 35.4 52.4 34.4 52 Z" />
    </g>
    <text class="kanji" x="36" y="60.4" text-anchor="middle" lang="ja">郵便</text>

    <path class="slot" d="M20.6 31 C28 30 44 30 51.4 31 C51.8 33.2 51.6 35.4 51 36.4 C44 35.6 28 35.6 21 36.4 C20.4 35.4 20.2 33.2 20.6 31 Z" />
    <path class="hood" d="M17.8 33.6 C19 25.4 53 25.4 54.2 33.6 C53.6 35 52.6 35.4 51.6 35 C44 33.2 28 33.2 20.4 35 C19.4 35.4 18.2 35 17.8 33.6 Z" />

    <path class="collar" d="M11.6 69 C11.4 66.2 60.6 66.2 60.4 69 L61 74 C61.2 76 10.8 76 11 74 Z" />
    <path class="hole" d="M26 79 C31 78.4 41 78.4 46 79 C46.4 81.6 46.2 84.4 45.8 85.6 C41 86.2 31 86.2 26.2 85.6 C25.8 84.4 25.6 81.6 26 79 Z" />
    <path class="hatch" d="M26 79 C31 78.4 41 78.4 46 79 C46.4 81.6 46.2 84.4 45.8 85.6 C41 86.2 31 86.2 26.2 85.6 C25.8 84.4 25.6 81.6 26 79 Z" />
    <circle class="key" cx="36" cy="82.3" r="1.2" />

    <!-- the WhatsApp bubble: tucked inside the bottom hatch until the box opens, then it comes out of the hatch and floats up above the lid, like a letter collected from the box -->
    <g class="chat"><g class="bob">
      <path class="bubble" d="M36 33 C43.2 32.6 49.8 38 49.6 45.4 C49.4 52.6 43 58.4 35.8 57.8 C33.2 57.6 30.8 56.8 28.8 55.6 L22.4 57.6 L24.6 51.4 C22.6 49 22.2 46.6 22.6 44.2 C23.4 37.8 29.2 33.4 36 33 Z" />
      <path class="handset" d="M30.8 40.6 C31.8 39.6 33 39.8 33.6 40.8 L34.6 42.8 C35 43.6 34.8 44.2 34.2 44.8 L33.4 45.6 C34.4 47.6 36 49.2 38 50.2 L38.8 49.4 C39.4 48.8 40 48.6 40.8 49 L42.8 50 C43.8 50.6 44 51.8 43 52.8 C41.6 54.2 39.2 54.2 36.6 52.8 C33.2 51 30.8 48.4 29.4 45 C28.6 43 29.2 41.6 30.8 40.6 Z" />
    </g></g>
    <!-- tiny hand-drawn grass around the plinth, each tuft sways from its roots (off under reduced motion) -->
    <g class="grass">
      <path class="tuft a g1" d="M-18.8 118.0 Q-22.1 109.3 -25.7 102.1 M-16.6 118.0 Q-20.1 107.6 -34.4 99.2 M-21.7 118.0 Q-25.9 107.1 -33.6 98.2 M-17.8 118.0 Q-20.0 104.1 -22.6 92.8 M-15.7 118.0 Q-13.6 103.2 -2.5 91.1" />
      <path class="tuft b g2" d="M-5.2 118.0 Q-5.8 112.7 -3.6 108.4 M-13.6 118.0 Q-13.8 112.3 -21.6 107.7 M-13.2 118.0 Q-12.5 110.0 -6.6 103.4 M-9.5 118.0 Q-11.6 112.6 -13.4 108.2" />
      <path class="tuft c g1" d="M3.8 118.0 Q1.0 109.0 -12.3 101.6 M1.5 118.0 Q3.0 109.8 4.1 103.1 M-0.6 118.0 Q1.3 108.0 0.1 99.9 M4.3 118.0 Q6.3 109.9 23.1 103.2 M1.2 118.0 Q1.4 106.9 2.6 97.8" />
      <path class="tuft b g2" d="M13.3 118.0 Q14.0 111.7 15.1 106.5 M21.8 118.0 Q23.3 113.0 27.2 108.9 M18.8 118.0 Q23.8 112.5 33.7 108.0" />
      <path class="tuft a g1" d="M32.7 118.0 Q29.6 110.6 12.3 104.6 M34.5 118.0 Q34.7 109.2 40.6 102.0 M31.8 118.0 Q29.6 110.6 21.4 104.6 M29.6 118.0 Q30.1 113.1 25.7 109.0" />
      <path class="tuft c g2" d="M46.2 118.0 Q46.3 113.3 37.7 109.4 M45.8 118.0 Q47.8 112.5 47.1 108.0 M53.2 118.0 Q52.7 110.9 52.6 105.1" />
      <path class="tuft b g1" d="M62.6 118.0 Q61.3 107.3 64.2 98.5 M60.7 118.0 Q58.1 111.0 47.8 105.2 M64.9 118.0 Q61.8 110.8 51.2 104.9 M62.7 118.0 Q67.2 109.1 80.7 101.8 M64.2 118.0 Q65.3 108.8 80.1 101.3" />
      <path class="tuft a g2" d="M80.0 118.0 Q81.8 109.0 82.1 101.6 M74.9 118.0 Q72.8 110.9 61.2 105.1 M71.6 118.0 Q69.0 112.6 66.3 108.2 M74.4 118.0 Q71.7 112.7 68.9 108.3" />
      <path class="tuft c g1" d="M80.0 118.0 Q76.9 106.8 55.8 97.6 M85.2 118.0 Q82.0 108.6 72.8 100.8 M82.6 118.0 Q86.8 108.8 92.3 101.2 M83.7 118.0 Q80.6 105.8 77.7 95.8 M82.4 118.0 Q84.9 107.6 102.5 99.1" />
      <path class="tuft b g2" d="M85.2 118.0 Q82.0 106.9 77.7 97.8 M90.4 118.0 Q92.2 112.2 88.5 107.4 M93.7 118.0 Q92.3 108.3 89.8 100.4 M86.6 118.0 Q89.8 107.9 95.8 99.7" />
    </g>
  </svg>
  </span>
</a>
<style>
  .postbox {
    position: fixed; z-index: 30; right: max(0.2rem, env(safe-area-inset-right)); bottom: 0;
    display: flex; align-items: flex-end; gap: var(--space-2); text-decoration: none; color: var(--color-text); -webkit-tap-highlight-color: transparent;
  }
  .box { position: relative; display: block; }

  
  .art { display: block; width: 7.1rem; height: auto; overflow: visible; filter: drop-shadow(0 6px 8px color-mix(in oklab, var(--color-shadow) 35%, transparent)); }
  @media (max-width: 40rem) { .art { width: 5.6rem; } .postbox__label { display: none; } }

  /* the plane starts at the bottom hatch (centre, about 70% down) */
  .planes { position: absolute; left: 50%; top: 69.5%; width: 0; height: 0; pointer-events: none; }
  .plane { position: absolute; left: -0.8rem; top: -0.53rem; width: 1.6rem; max-width: none; height: auto; opacity: 0; overflow: visible; }
  .plane path { fill: var(--pb-paper); stroke: var(--pb-ink); stroke-width: 1.3; stroke-linejoin: round; }
  .plane .dmg { opacity: 0; }
  .plane .dmg path { fill: none; stroke-width: 0.9; stroke-linecap: round; }
  .plane.hurt .dmg { opacity: 0.85; }
  .plane .fold { fill: none; stroke-width: 1; opacity: 0.6; }

  .slab-top { fill: var(--pb-stone-top); }
  .slab-front { fill: var(--pb-stone-front); }
  .slab-line, .ring-line { fill: none; stroke: var(--pb-ink); stroke-width: 0.8; stroke-linecap: round; opacity: 0.3; }
  .ring-side { fill: var(--pb-stone-side); }
  .ring-top { fill: var(--pb-stone-ring); }
  .grass { pointer-events: none; }
  .tuft { fill: none; stroke-width: 1.9; stroke-linecap: round; transform-box: fill-box; transform-origin: 50% 100%; }
  .g1 { stroke: var(--pb-grass-a); }
  .g2 { stroke: var(--pb-grass-b); }
  .body { fill: var(--pb-ink); }
  .shine { fill: var(--pb-paper); opacity: 0.18; }
  .hole { fill: color-mix(in oklab, var(--pb-ink) 50%, black); }
  .lid, .collar, .hood, .hatch, .base { fill: var(--pb-trim); }
  .rim { fill: none; stroke: var(--pb-ink); stroke-width: 1.2; stroke-linecap: round; opacity: 0.5; }
  .plaque { fill: var(--pb-trim); }
  .plaque-rim { fill: var(--pb-ink); }
  .mark { fill: var(--pb-paper); }
  .kanji { fill: var(--pb-paper); font-family: var(--font-jp); font-size: 6.6px; font-weight: 700; letter-spacing: 0.5px; }
  .slot { fill: var(--pb-paper); }
  .key { fill: var(--pb-ink); }
  .bubble { fill: var(--pb-trim); stroke: var(--pb-ink); stroke-width: 1.9; stroke-linejoin: round; }
  .handset { fill: var(--pb-ink); }

  .postbox__label { margin-bottom: 1.1rem; padding: 0.15rem 0.45rem; background: var(--color-surface); border: var(--border) solid var(--color-line-strong); border-radius: var(--radius-1); white-space: nowrap; opacity: 0; transform: translateX(6px); pointer-events: none; }

  /* closed: the bubble is tucked inside the bottom hatch (its centre is about 37 units below where it is drawn), the hatch is shut */
  .chat { transform-box: fill-box; transform-origin: 50% 100%; transform: translateY(37px) scale(0.3); opacity: 0; }
  .hatch, .key { transform-box: fill-box; transform-origin: 50% 100%; }
  .bob { transform-box: fill-box; transform-origin: 50% 60%; }

  /* open on hover and on keyboard focus: the bottom hatch drops open (it is hinged at its lower edge), then the bubble comes out of it and floats up above the lid */
  .postbox:hover .hatch, .postbox:focus-visible .hatch, .postbox.sending .hatch { transform: translateY(1.2px) scaleY(0.2); }
  .postbox:hover .key, .postbox:focus-visible .key, .postbox.sending .key { opacity: 0; }
  .postbox:hover .chat, .postbox:focus-visible .chat { transform: translateY(-50px) scale(1.2) rotate(-8deg); opacity: 1; }
  .postbox:hover .postbox__label, .postbox:focus-visible .postbox__label { opacity: 1; transform: none; }
  .postbox:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 4px; border-radius: var(--radius-2); }
  .postbox:active svg { transform: translateY(1px); }

  @media (prefers-reduced-motion: no-preference) {
    .postbox:hover .bob, .postbox:focus-visible .bob { animation: bob 1.4s ease-in-out 0.55s infinite alternate; }
    @keyframes bob { from { transform: translateY(0) rotate(-3deg); } to { transform: translateY(-3px) rotate(3deg); } }
    .tuft { animation: sway 2.2s ease-in-out infinite alternate; }
    .tuft.b { animation-duration: 1.8s; animation-delay: -0.7s; }
    .tuft.c { animation-duration: 2.8s; animation-delay: -1.5s; }
    @keyframes sway { from { transform: rotate(-8deg) skewX(-12deg); } to { transform: rotate(9deg) skewX(12deg); } }
    .hatch { transition: transform var(--dur-med) var(--ease-press); }
    .key { transition: opacity var(--dur-fast); }
    .chat { transition: transform 700ms var(--ease-press) 160ms, opacity 120ms 160ms; }
    .postbox__label { transition: opacity var(--dur-med), transform var(--dur-med) var(--ease-out); }
  }
</style>
