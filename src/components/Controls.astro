---
// Two hand-drawn icon buttons hanging from cords that are tied to the top edge of the page: a Hoi An lantern
// for light and dark mode, a speaker for sound. The whole hanging unit swings from the page top like a pendulum.
// The lantern is lit in light mode (the default) and goes out when you switch to dark mode.
// State lives in aria-pressed, set by src/scripts/site.ts: theme pressed = dark, sound pressed = on.
// Colours are tokens. Sway, glow and sound waves are off under reduced motion.
---
<div class="controls">
  <button type="button" class="icon theme" data-theme-toggle aria-pressed="false" aria-label="Dark mode" title="Light or dark">
    <span class="hang" style="--cord: 1.65rem"><span class="cord" aria-hidden="true"></span>
    <svg viewBox="-2 0 44 56" aria-hidden="true" focusable="false">
      <defs>
        <!-- silk lit from inside: bright in the middle, soft sage at the edges -->
        <radialGradient id="lantern-silk" cx="50%" cy="52%" r="55%">
          <stop offset="0" style="stop-color: var(--color-surface)" />
          <stop offset="0.5" style="stop-color: color-mix(in oklab, var(--color-surface) 60%, var(--color-accent))" />
          <stop offset="1" style="stop-color: var(--color-accent)" />
        </radialGradient>
        <!-- light spilling out of it: brighter than the page, not darker, so it reads as light and not as a shadow -->
        <radialGradient id="lantern-pool" cx="50%" cy="50%" r="50%">
          <stop offset="0" style="stop-color: white; stop-opacity: 1" />
          <stop offset="0.4" style="stop-color: white; stop-opacity: 0.75" />
          <stop offset="1" style="stop-color: white; stop-opacity: 0" />
        </radialGradient>
      </defs>
      <circle class="pulse" cx="20" cy="27" r="9" />
      <circle class="pool" cx="20" cy="27" r="30" fill="url(#lantern-pool)" />
      <g class="rays"><path d="M45.6 33.9 L50.9 35.3" /><path d="M38.0 45.0 L40.9 47.9" /><path d="M26.9 52.6 L28.3 57.9" /><path d="M13.4 51.6 L12.4 55.5" /><path d="M1.3 45.7 L-2.6 49.6" /><path d="M-4.6 33.6 L-8.5 34.6" /><path d="M-5.6 20.1 L-10.9 18.7" /><path d="M2.0 9.0 L-0.9 6.1" /><path d="M13.1 1.4 L11.7 -3.9" /><path d="M26.6 2.4 L27.6 -1.5" /><path d="M38.7 8.3 L42.6 4.4" /><path d="M44.6 20.4 L48.5 19.4" /></g>
      <g class="kick"><g class="swing">
        <path class="string" d="M20 0 C19.5 2.5 20.5 4.5 20 7.6" />
        <g class="lamp">
          <path class="cap" d="M13 8 L14.6 6.4 L17 8 L20 6.2 L23 8 L25.4 6.4 L27 8 L26 11.4 C23 12.4 17 12.4 14 11.4 Z" />
          <path class="body" d="M5.4 26 C4.6 17 12 11.8 20 11.6 C28 11.8 35.4 17 34.6 26 C35 35 28 40.6 20 41 C12 40.6 5 35 5.4 26 Z" />
          <ellipse class="core" cx="20" cy="26.4" rx="5.6" ry="7.2" />
          <path class="rib" d="M20 11.8 C20.4 21 19.6 31 20 41" />
          <path class="rib" d="M20 11.8 C11 18 11 35 20 41" />
          <path class="rib" d="M20 11.8 C29 18 29 35 20 41" />
          <path class="rib" d="M20 11.8 C7.6 17.6 7.2 34.6 20 41" opacity=".5" />
          <path class="rib" d="M20 11.8 C32.4 17.6 32.8 34.6 20 41" opacity=".5" />
          <path class="cap" d="M14.4 40.6 C17.4 42 22.6 42 25.6 40.6 L24.8 43.6 C22.4 44.6 17.6 44.6 15.2 43.6 Z" />
          <g class="tassel-g">
            <path class="tassel" d="M20 44.6 V54 M17.6 44.8 C16.6 48 16.2 51 16.6 53.6 M22.4 44.8 C23.4 48 23.8 51 23.4 53.6 M15.2 44.4 C13.4 47 12.6 50 12.8 52.4 M24.8 44.4 C26.6 47 27.4 50 27.2 52.4" />
            <circle class="bead" cx="20" cy="47.2" r="1.4" />
          </g>
        </g>
      </g></g>
    </svg></span>
  </button>
  <button type="button" class="icon sound" data-sound-toggle aria-pressed="false" aria-label="Sound" title="Sound on or off">
    <span class="hang" style="--cord: 1.92rem"><span class="cord" aria-hidden="true"></span>
    <svg viewBox="0 0 44 40" aria-hidden="true" focusable="false">
      <path class="speaker" d="M6.4 15.2 C6 15 6.2 24.8 6.4 25 C8.2 25.4 10.2 25.2 12 25 L19.6 31.8 C20.6 32.4 21.6 31.8 21.6 30.8 L21.6 9.4 C21.6 8.4 20.6 7.8 19.6 8.4 L12 15 C10.2 14.8 8.2 14.8 6.4 15.2 Z" />
      <g class="waves">
        <path class="wave w1" d="M26.4 15.4 C29 18.2 29 22.4 26.4 25" />
        <path class="wave w2" d="M31 11.2 C35.8 16 35.8 24 31 28.8" />
      </g>
      <g class="mute">
        <path d="M27 15 L36.6 25.4" /><path d="M36.4 15 L27.2 25.6" />
      </g>
    </svg></span>
  </button>
</div>
<style>
  /* The icons hang from cords tied to the top edge of the page (Nav makes the header the positioning box). */
  .controls { position: absolute; top: 0; right: 0; display: flex; align-items: flex-start; gap: 0.25rem; z-index: 10; }
  .icon { display: block; width: 2.7rem; padding: 0; color: var(--color-text); }
  .hang { position: relative; display: grid; justify-items: center; transform-origin: 50% 0; }
  .hang::before { content: ""; position: absolute; top: -3px; left: 50%; width: 7px; height: 7px; margin-left: -3.5px; border-radius: 50%; background: var(--color-accent); border: 1.4px solid var(--color-text); }
  .cord { display: block; width: 12px; height: var(--cord); background: var(--color-text); -webkit-mask: url("/line-v.svg") center top / 12px 1200px no-repeat; mask: url("/line-v.svg") center top / 12px 1200px no-repeat; }
  .icon svg { width: 1.9rem; height: auto; margin-top: -1px; overflow: visible; fill: none; stroke: var(--color-text); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform var(--dur-med) var(--ease-press); }
  .icon:hover svg { transform: scale(1.06); }
  .icon:active svg { transform: scale(0.96); }

  /* lantern: lit by default, out in dark mode. Lit means luminous silk, a pool of light that is brighter than the
     page (never a dark shadow), a few rays of light, and a soft wash of light across the nav behind it. */
  .string, .tassel { stroke: var(--color-text); }
  .cap { fill: var(--color-text); stroke: none; }
  .bead { fill: var(--color-accent); stroke: var(--color-text); stroke-width: 1; }
  .body { fill: url(#lantern-silk); stroke: var(--color-text); stroke-width: 1.7; }
  .core { fill: white; stroke: none; opacity: 0.95; transition: opacity var(--dur-slow); }
  .pool { stroke: none; mix-blend-mode: screen; transition: opacity var(--dur-slow); }
  .rays path { stroke: var(--color-accent); stroke-width: 1.7; opacity: 0.95; transition: opacity var(--dur-slow); }
  .rib { stroke: var(--color-text); stroke-width: 1.15; }
  .theme { position: relative; }
  .theme::before { content: ""; position: absolute; left: 50%; top: 42%; width: 15rem; height: 15rem; transform: translate(-50%, -50%); z-index: -1; pointer-events: none; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, white 70%, transparent), transparent); opacity: 1; transition: opacity var(--dur-slow); }
  .theme[aria-pressed="true"]::before, .theme[aria-pressed="true"] .pool, .theme[aria-pressed="true"] .core, .theme[aria-pressed="true"] .rays path { opacity: 0; }
  .theme[aria-pressed="true"] .body { fill: var(--color-surface-sunken); }
  .lamp, .tassel-g { transform-box: fill-box; transform-origin: 50% 0; }
  .pool, .rays, .pulse { transform-box: fill-box; transform-origin: center; }
  .pulse { fill: none; stroke: var(--color-accent-ink); stroke-width: 1.6; opacity: 0; }
  .theme[aria-pressed="true"]::before { transition-duration: 90ms; } /* the wash is gone at once when the light goes out, it never lingers as a glow on the dark page */

  /* speaker: waves when on, a cross when off */
  .speaker { fill: var(--color-accent); stroke: var(--color-text); stroke-width: 1.7; }
  .wave { stroke: var(--color-text); stroke-width: 1.8; }
  .mute path { stroke: var(--color-text); stroke-width: 2; }
  .sound[aria-pressed="false"] .waves { display: none; }
  .sound[aria-pressed="true"] .mute { display: none; }
  .sound[aria-pressed="false"] .speaker { fill: var(--color-surface-sunken); }

  /* A hanging lantern: the whole thing swings from its string like a pendulum, the lamp lags a little behind,
     and the tassel lags further. Hovering gives it a push (bigger, quicker swings). --amp is registered so
     the push eases in and out instead of jumping. */
  @property --amp { syntax: '<number>'; inherits: true; initial-value: 5; }
  @media (prefers-reduced-motion: no-preference) {
    .icon { --amp: 3.2; transition: --amp 700ms var(--ease-out); }
    .icon:hover { --amp: 6.5; }
    .theme[aria-pressed="true"] { --amp: 1; }
    .theme[aria-pressed="true"]:hover { --amp: 2.6; }
    .hang { animation: swing 5.6s ease-in-out infinite alternate; }
    .sound .hang { animation-duration: 4.7s; animation-delay: -1.3s; }
    .lamp { animation: lag 3.6s ease-in-out -0.7s infinite alternate; }
    .tassel-g { animation: tassel 2.7s ease-in-out -1.1s infinite alternate; }
    .icon:hover .hang { animation-duration: 2.6s; } .theme:hover .lamp { animation-duration: 1.9s; } .theme:hover .tassel-g { animation-duration: 1.4s; }
    .theme[aria-pressed="false"] .pool { animation: breathe 3.8s ease-in-out infinite alternate; }
    .theme[aria-pressed="false"] .core { animation: flicker 2.3s ease-in-out -0.8s infinite alternate; }
    .theme[aria-pressed="false"] .rays path { animation: ray 2.6s ease-in-out infinite alternate; }
    .theme[aria-pressed="false"] .rays path:nth-child(3n) { animation-delay: -0.9s; } .theme[aria-pressed="false"] .rays path:nth-child(3n+1) { animation-delay: -1.7s; }
    /* one-off kicks when the light is switched */
    .theme[data-just="on"] .hang { animation: kick-on 1.1s var(--ease-out); }
    .theme[data-just="on"] .pool { animation: flare 0.9s var(--ease-out); }
    .theme[data-just="on"] .pulse { animation: ring 1s var(--ease-out); }
    .theme[data-just="off"] .hang { animation: kick-off 1.4s ease-out; }
    .sound[aria-pressed="true"] .wave { animation: wave 1.5s ease-in-out infinite; }
    .sound[aria-pressed="true"] .w2 { animation-delay: 0.25s; }
    @keyframes swing { from { transform: rotate(calc(var(--amp) * -1deg)); } to { transform: rotate(calc(var(--amp) * 1deg)); } }
    @keyframes lag { from { transform: rotate(calc(var(--amp) * 0.32deg)); } to { transform: rotate(calc(var(--amp) * -0.32deg)); } }
    @keyframes tassel { from { transform: rotate(calc(var(--amp) * -0.9deg)); } to { transform: rotate(calc(var(--amp) * 0.9deg)); } }
    @keyframes flicker { from { opacity: 0.62; } to { opacity: 0.92; } }
    @keyframes breathe { from { opacity: 0.78; transform: scale(0.95); } to { opacity: 1; transform: scale(1.06); } }
    @keyframes ring { 0% { opacity: 0.95; transform: scale(0.7); } 100% { opacity: 0; transform: scale(3.6); } }
    @keyframes ray { from { opacity: 0.35; } to { opacity: 1; } }
    @keyframes flare { 0% { opacity: 0.1; transform: scale(0.6); } 35% { opacity: 1; transform: scale(1.25); } 100% { opacity: 0.9; transform: scale(1); } }
    @keyframes kick-on { 0% { transform: rotate(-6deg); } 40% { transform: rotate(4deg); } 70% { transform: rotate(-1.6deg); } 100% { transform: rotate(0); } }
    @keyframes kick-off { 0% { transform: rotate(5deg); } 25% { transform: rotate(-3.4deg); } 50% { transform: rotate(2deg); } 75% { transform: rotate(-0.9deg); } 100% { transform: rotate(0); } }
    @keyframes wave { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
  }
</style>
