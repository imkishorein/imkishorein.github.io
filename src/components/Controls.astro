---
// Theme and sound toggles. Behaviour lives in src/scripts/site.ts.
---
<div class="controls">
  <button type="button" class="ctl pixel" data-theme-toggle aria-pressed="false"><span data-theme-label>Theme</span></button>
  <button type="button" class="ctl pixel" data-sound-toggle aria-pressed="false"><span data-sound-label>Sound off</span></button>
</div>
<style>
  .controls { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .ctl { font-size: var(--step--1); padding: var(--space-1) var(--space-3); border: var(--border) solid var(--color-line-strong); border-radius: var(--radius-1); color: var(--color-text); transition: background var(--dur-fast), color var(--dur-fast); }
  .ctl:hover { background: var(--color-strong); color: var(--color-on-strong); }
  .ctl[aria-pressed="true"] { background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); }
</style>
