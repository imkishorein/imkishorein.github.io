---
import { nav, site } from '../data/site';
import Controls from './Controls.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="wrap bar">
  <a class="mark" href="/" data-sound="tick" aria-label={`${site.name}, home`}>
    <span class="mark__name">{site.name}</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {nav.map((n) => (
        <li>
          <a href={n.href} class:list={['link', { current: isCurrent(n.href) }]} aria-current={isCurrent(n.href) ? 'page' : undefined} data-sound="tick">
            <span class="label">{n.label}</span>
            <span class="jp" lang="ja" aria-hidden="true">{n.jp}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <Controls />
</header>
<style>
  .bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-4) var(--space-6); padding-block: var(--space-5) var(--space-3); }
  .mark { text-decoration: none; font-weight: 600; letter-spacing: -0.02em; font-size: var(--step-0); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .link { position: relative; display: inline-block; padding-block: var(--space-1) var(--space-5); text-decoration: none; color: var(--color-text-muted); transition: color var(--dur-fast); }
  .link:hover, .link:focus-visible, .link.current { color: var(--color-text); }
  .link::after { content: ""; position: absolute; left: 0; right: 0; bottom: calc(var(--space-5) - var(--rule-height) / 2); height: var(--rule-height); background: var(--color-line-strong); -webkit-mask: var(--hand-solid-b) left center / var(--rule-tile) var(--rule-height) no-repeat; mask: var(--hand-solid-b) left center / var(--rule-tile) var(--rule-height) no-repeat; transform: scaleX(0); transform-origin: left; transition: transform var(--dur-med) var(--ease-out); }
  .link:hover::after, .link:focus-visible::after, .link.current::after { transform: scaleX(1); }
  @media (max-width: 40rem) { ul { gap: var(--space-1) var(--space-5); } .link { padding-block: var(--space-2) var(--space-5); } }
  .jp { position: absolute; left: 0; bottom: 0; font-size: var(--step--1); color: var(--color-accent-ink); opacity: 0; transform: translateY(-3px); transition: opacity var(--dur-med), transform var(--dur-med) var(--ease-out); }
  .link:hover .jp, .link:focus-visible .jp, .link.current .jp { opacity: 1; transform: none; }
</style>
