---
import { nav, site } from '../data/site';
import Controls from './Controls.astro';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const waHref = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.message)}`;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="wrap bar" data-menu>
  <a class="mark" href="/" data-sound="tick" aria-label="imkishore.in, home">
    <img class="mark__img" src="/kishore-logo.png" width="44" height="44" alt="" />
    <Wordmark />
  </a>
  <button type="button" class="burger" aria-expanded="false" aria-controls="menu-panel" aria-label="Menu" data-sound="tick">
    <svg viewBox="0 0 44 44" aria-hidden="true" focusable="false">
      <path class="b1" d="M10 14.4 C16 13.2 27 15.4 34 14" />
      <path class="b2" d="M10 22.2 C17 23.2 27 21 34 22.4" />
      <path class="b3" d="M10 30 C15 31.2 28 28.8 34 30.2" />
    </svg>
  </button>
  <div class="panel" id="menu-panel">
  <nav aria-label="Main">
    <ul>
      {nav.map((n) => (
        <li>
          <a href={n.href} class:list={['link', { current: isCurrent(n.href) }]} aria-current={isCurrent(n.href) ? 'page' : undefined} data-sound="tick">
            <span class="label">{n.label}</span>
            <span class="jp" lang="ja" aria-hidden="true">{n.jp}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <a class="wa rule-top" href={waHref} target="_blank" rel="noopener" data-sound="thunk">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.2 C17 3 21 6.8 20.8 11.8 C20.6 16.6 16.8 20.4 12 20.2 C10.4 20.1 8.9 19.7 7.6 18.9 L3.6 20.4 L4.9 16.6 C3.9 15.2 3.3 13.6 3.4 11.8 C3.6 7 7.2 3.4 12 3.2 Z" /><path d="M9 8.4 C9.6 7.8 10.4 8 10.7 8.7 L11.3 10 C11.5 10.5 11.4 10.9 11 11.3 L10.6 11.7 C11.2 12.9 12.1 13.8 13.3 14.4 L13.7 14 C14.1 13.6 14.5 13.5 15 13.8 L16.2 14.4 C16.8 14.8 16.9 15.4 16.4 16 C15.6 16.8 14.2 16.8 12.7 16 C10.7 14.9 9.3 13.4 8.5 11.4 C8 10.2 8.3 9.1 9 8.4 Z" /></svg>
    <span class="label">Message me on WhatsApp</span>
  </a>
  </div>
  <Controls />
</header>
<script>
  /* phone menu: a disclosure (the links only; the lantern and speaker stay in the bar). Closes on Escape, on a tap outside, on a link, and when the window grows to desktop width. */
  const bar = document.querySelector<HTMLElement>('[data-menu]');
  const burger = bar?.querySelector<HTMLButtonElement>('.burger');
  const setOpen = (open: boolean) => {
    if (!bar || !burger) return;
    if (open) bar.dataset.open = ''; else delete bar.dataset.open;
    burger.setAttribute('aria-expanded', String(open));
  };
  burger?.addEventListener('click', () => setOpen(!bar?.hasAttribute('data-open')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && bar?.hasAttribute('data-open')) { setOpen(false); burger?.focus(); } });
  document.addEventListener('pointerdown', (e) => { if (bar?.hasAttribute('data-open') && !bar.contains(e.target as Node)) setOpen(false); });
  bar?.querySelectorAll('nav a, .wa').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  matchMedia('(min-width: 40.01rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
<style>
  .bar { position: relative; display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: var(--space-4) var(--space-6); padding-block: var(--space-5) var(--space-3); }
  nav { margin-right: 7.2rem; margin-top: 0.3rem; } /* nudges the link text onto the logo's centre line */ /* leave room for the two hanging icons at the right edge */
  @media (max-width: 52rem) { nav { margin-right: 0; } } /* when the nav wraps below the logo it sits under the icons, so it can use the full width */
  .mark { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; font-weight: 600; letter-spacing: -0.02em; font-size: var(--step-0); }
  /* the logo is a round, rubber-stamp style portrait with its own ring that tilts a little when you point at it */
  .mark__img { width: 2.75rem; height: 2.75rem; border-radius: 50%; flex: none; transition: transform var(--dur-med) var(--ease-press); }
  .mark:hover .mark__img, .mark:focus-visible .mark__img { transform: rotate(-6deg) scale(1.06); }
  @media (prefers-reduced-motion: reduce) { .mark__img { transition: none; } .mark:hover .mark__img, .mark:focus-visible .mark__img { transform: none; } }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .link { position: relative; display: inline-block; padding-block: var(--space-1) var(--space-5); text-decoration: none; color: var(--color-text-muted); transition: color var(--dur-fast); }
  .link:hover, .link:focus-visible, .link.current { color: var(--color-text); }
  .link::after { content: ""; position: absolute; left: 0; right: 0; bottom: calc(var(--space-5) - var(--rule-height) / 2); height: var(--rule-height); background: var(--color-line-strong); -webkit-mask: var(--hand-solid-b) left center / var(--rule-tile) var(--rule-height) no-repeat; mask: var(--hand-solid-b) left center / var(--rule-tile) var(--rule-height) no-repeat; transform: scaleX(0); transform-origin: left; transition: transform var(--dur-med) var(--ease-out); }
  .link:hover::after, .link:focus-visible::after, .link.current::after { transform: scaleX(1); }
  .jp { position: absolute; left: 0; bottom: 0; font-size: var(--step--1); color: var(--color-accent-ink); opacity: 0; transform: translateY(-3px); transition: opacity var(--dur-med), transform var(--dur-med) var(--ease-out); }
  .link:hover .jp, .link:focus-visible .jp, .link.current .jp { opacity: 1; transform: none; }

  /* ───────── phones: logo, wordmark and a hamburger. The links, the lantern and the speaker live in a paper card that drops from the bar. ───────── */
  .panel { display: contents; }
  .wa { display: none; }
  .burger { display: none; }
  @media (max-width: 40rem) {
    .bar { flex-wrap: nowrap; align-items: center; }
    .mark { min-width: 0; }
    .burger { display: block; flex: none; width: 2.75rem; height: 2.75rem; margin-right: -0.4rem; color: var(--color-text); -webkit-tap-highlight-color: transparent; }
    .burger svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 2.3; stroke-linecap: round; }
    .burger path { transform-box: fill-box; transform-origin: center; transition: transform var(--dur-med) var(--ease-press), opacity var(--dur-fast); }
    [data-open] .b1 { transform: translateY(7.8px) rotate(42deg); }
    [data-open] .b3 { transform: translateY(-7.8px) rotate(-42deg); }
    [data-open] .b2 { opacity: 0; transform: scaleX(0.2); }
    .panel { display: none; position: absolute; z-index: 25; left: 0; right: 0; top: 100%; padding: var(--space-4) var(--space-5); background: var(--color-surface); border-radius: var(--radius-3); box-shadow: var(--shadow-card); }
    [data-open] .panel { display: block; animation: drop var(--dur-med) var(--ease-out); }
    @keyframes drop { from { opacity: 0; transform: translateY(-8px); } }
    nav { margin: 0; }
    .wa { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-3); padding: var(--space-4) 0 var(--space-1); text-decoration: none; color: var(--color-text-muted); }
    .wa svg { width: 1.5rem; height: 1.5rem; flex: none; fill: none; stroke: var(--color-text); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    .wa:hover, .wa:focus-visible { color: var(--color-text); }
    /* the lantern and speaker stay in the bar: they still hang from the top edge, in the gap between the wordmark and the hamburger, and end no lower than it */
    /* each icon is a 44px tap target with a gap between them; the cords are long enough that the lantern and speaker sit level with the hamburger */
    .bar :global(.controls) { right: 2.9rem; gap: 0.4rem; }
    .bar :global(.icon) { width: 2.75rem; }
    .bar :global(.icon svg) { width: 1.9rem; }
    .bar :global(.theme .hang) { --cord: 1.8rem !important; }
    .bar :global(.sound .hang) { --cord: 2.1rem !important; }
    ul { display: grid; grid-template-columns: 1fr; gap: 0; }
    .link { display: flex; align-items: baseline; gap: var(--space-3); width: 100%; padding-block: 0.7rem 0.85rem; }
    .link::after { bottom: 0.45rem; }
    .jp { position: static; opacity: 1; transform: none; } /* no hover on a phone, so the Japanese label is always shown */
  }
  /* narrow phones: a smaller logo and wordmark so the icons never touch the name */
  @media (max-width: 26rem) { .bar :global(.wms) { height: 2.1rem; } .bar :global(.v6) { font-size: 1.35rem; } } /* the Typed style is text, so it scales by font size, not height */
  @media (max-width: 23rem) { .mark { gap: var(--space-2); } .mark__img { width: 2.25rem; height: 2.25rem; } .bar :global(.wms) { height: 1.5rem; } .bar :global(.v6) { font-size: 1rem; } .bar :global(.controls) { right: 2.7rem; gap: 0.15rem; } .bar :global(.icon) { width: 2.5rem; } .bar :global(.icon svg) { width: 1.7rem; } }
</style>
