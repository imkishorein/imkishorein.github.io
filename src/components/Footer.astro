---
import { site } from '../data/site';
import Postbox from './Postbox.astro';
import WeatherIcon from './WeatherIcon.astro';
import Socials from './Socials.astro';
const updated = new Date().toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
---
<footer class="wrap foot">
  <div class="foot__top">
    <p class="label muted" style="grid-area: label">Say hello</p>
    <a class="mail display" style="grid-area: mail" href={`mailto:${site.email}`} data-sound="thunk">{site.email}</a>
    <div class="icons" style="grid-area: icons"><Socials /></div>
    <!-- filled by src/scripts/live.ts, stays hidden if the weather request fails -->
    <p class="here muted" style="grid-area: wx" data-live-row hidden><WeatherIcon /><span>Bengaluru right now: <span data-live-wx></span></span></p>
  </div>
  <div class="foot__bottom rule-top">
    <p class="muted mono small">Last updated {updated}.<span class="more"> Set in a pixel and a sans. Try shift-clicking anywhere.</span></p>
    <button type="button" class="hanko" data-hanko lang="ja" aria-label="Leave a hanko seal on the page" title="印 (in): a seal. Tap it, or shift-click anywhere.">印</button>
    <!-- fixed in the corner on desktop; on phones it stands on the ground line above the colophon (see Postbox.astro) -->
    <Postbox />
  </div>
</footer>
<script>import '../scripts/live.ts';</script>
<style>
  .foot { padding-block: var(--space-9) var(--space-6); display: grid; gap: var(--space-7); }
  /* the email and the social buttons share one row: email left, buttons right */
  .foot__top { display: grid; grid-template-columns: auto 1fr; grid-template-areas: "label ." "mail icons" "wx ."; column-gap: var(--space-6); align-items: center; }
  .icons { justify-self: end; }
  @media (max-width: 52rem) { .foot__top { grid-template-columns: 1fr; grid-template-areas: "label" "mail" "icons" "wx"; row-gap: var(--space-3); } .icons { justify-self: start; } }
  .mail { position: relative; display: inline-block; padding-bottom: 0.45em; font-size: var(--step-3); text-decoration: none; word-break: break-all; }
  /* hand-drawn curly underline, tiled from public/line-curl.svg and coloured by a token */
  .mail::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 0.42em; background: var(--color-accent); transition: background var(--dur-fast);
    -webkit-mask: url("/line-curl.svg") left center / auto 100% repeat-x; mask: url("/line-curl.svg") left center / auto 100% repeat-x; }
  .mail:hover::after { background: var(--color-text); }
  .here { display: flex; align-items: center; gap: var(--space-3); font-size: var(--step--1); margin-top: var(--space-4); }
  .here[hidden] { display: none; }
  .foot__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-5); padding-top: var(--space-5); }
  .small { font-size: var(--step--1); max-width: 46ch; }
  /* phones: contact, a rule, then one last row with the seal at the left edge and the postbox at the right edge, both standing on the same
     ground line. The colophon and the shift-click hint are hidden (no Shift on touch, and the line adds noise on a small screen); the seal does the hanko job when tapped. */
  @media (max-width: 40rem) {
    .foot { padding-block: var(--space-7) 0; gap: var(--space-6); } /* no bottom padding: the postbox's ground is the bottom edge of the page */
    .foot__bottom { display: grid; grid-template-columns: auto 1fr; grid-template-areas: "seal box"; align-items: end; column-gap: var(--space-3); padding-top: var(--space-2); }
    .foot__bottom > :global(.postbox) { grid-area: box; }
    .foot__bottom .hanko { grid-area: seal; margin-bottom: 0.9rem; }
    .foot__bottom .small { display: none; }
  }
</style>
