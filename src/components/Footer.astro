---
import { site } from '../data/site';
import Postbox from './Postbox.astro';
const updated = new Date().toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
---
<footer class="wrap foot">
  <div class="foot__top">
    <div>
      <p class="label muted">Say hello</p>
      <a class="mail display" href={`mailto:${site.email}`} data-sound="thunk">{site.email}</a>
    </div>
    <ul class="links">
      {site.links.map((l) => <li><a href={l.href} rel="me noopener" target={l.href.startsWith('http') ? '_blank' : undefined}>{l.label}</a></li>)}
    </ul>
  </div>
  <div class="foot__bottom rule-top">
    <p class="muted mono small">Last updated {updated}.<span class="more"> Set in a pixel and a sans. Try shift-clicking anywhere.</span></p>
    <button type="button" class="hanko" data-hanko lang="ja" aria-label="Leave a hanko seal on the page" title="印 (in): a seal. Tap it, or shift-click anywhere.">印</button>
    <!-- fixed in the corner on desktop; on phones it stands on the ground line above the colophon (see Postbox.astro) -->
    <Postbox />
  </div>
</footer>
<style>
  .foot { padding-block: var(--space-9) var(--space-6); display: grid; gap: var(--space-7); }
  .foot__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-6); align-items: end; }
  .mail { font-size: var(--step-3); text-decoration: none; word-break: break-all; border-bottom: 2px solid var(--color-accent); transition: border-color var(--dur-fast); }
  .mail:hover { border-color: var(--color-text); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .links a { text-underline-offset: 0.25em; text-decoration-color: var(--color-line-strong); }
  .links a:hover { text-decoration-color: currentColor; }
  .foot__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-5); padding-top: var(--space-5); }
  .small { font-size: var(--step--1); max-width: 46ch; }
  /* phones: contact, a rule, then one last row with the seal at the left edge and the postbox at the right edge, both standing on the same
     ground line. The colophon and the shift-click hint are hidden (no Shift on touch, and the line adds noise on a small screen); the seal does the hanko job when tapped. */
  @media (max-width: 40rem) {
    .foot { padding-block: var(--space-7) 0; gap: var(--space-6); } /* no bottom padding: the postbox's ground is the bottom edge of the page */
    .foot__bottom { display: grid; grid-template-columns: auto 1fr; grid-template-areas: "seal box"; align-items: end; column-gap: var(--space-3); padding-top: var(--space-2); }
    .foot__bottom > :global(.postbox) { grid-area: box; }
    .foot__bottom .hanko { grid-area: seal; margin-bottom: 0.9rem; }
    .foot__bottom .small { display: none; }
  }
</style>
