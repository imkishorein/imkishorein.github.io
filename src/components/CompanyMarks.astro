---
// One hand-drawn company mark, shown in the row of the job it belongs to on About.
// Each logo is redrawn by hand, close to the original shapes, in the site's two inks.
// Paths come from src/data/company-marks.ts (generated by scripts/gen-company-marks.mjs).
import { companyMarks } from '../data/company-marks';
interface Props { name: string; class?: string; }
const { name, class: cls = '' } = Astro.props;
const m = companyMarks.find((c) => name.startsWith(c.name));
---
{!m ? <span /> : (
  <div class:list={['mark', cls]}>
    <svg viewBox="0 0 120 80" role="img" aria-label={m.name}>
      {m.parts.map((p) => <path d={p.d} class={p.role} stroke-width={p.w || undefined} />)}
    </svg>
  </div>
)}
<style>
  .mark { width: 7.5rem; aspect-ratio: 3 / 2; transform: rotate(-1.5deg); transition: transform var(--dur-med) var(--ease-press); }
  :global(.row:hover) .mark { transform: rotate(1deg) translateY(-2px); }
  svg { display: block; width: 100%; height: 100%; overflow: visible; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ink { stroke: var(--color-text); }
  .deep { stroke: var(--art-deep); } /* fixed dark ink for text sitting on the sage cloud, in both themes */
  .light { stroke: var(--color-bg); }
  .ink-muted { stroke: var(--color-text-muted); }
  .ink-accent { stroke: var(--color-accent); }
  .solid-ink { fill: var(--color-text); stroke: none; }
  .solid-light { fill: var(--color-bg); stroke: none; }
  .solid-accent { fill: var(--color-accent); stroke: none; }
  .solid-bg { fill: var(--color-bg); stroke: none; }
  .facet-ink { fill: var(--color-text); stroke: var(--color-bg); }
  .facet-muted { fill: var(--color-text-muted); stroke: var(--color-bg); }
  .facet-accent { fill: var(--color-accent); stroke: var(--color-bg); }
  .fill-ink { fill: var(--color-text); stroke: var(--color-text); }
  .fill-light { fill: var(--color-bg); stroke: var(--color-text); }
  .fill-accent { fill: var(--color-accent); stroke: var(--color-text); }
  @media (prefers-reduced-motion: reduce) { .mark { transition: none; } :global(.row:hover) .mark { transform: rotate(-1.5deg); } }
</style>
