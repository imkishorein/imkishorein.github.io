---
// The portrait stamp, laid out like a real Indian airmail stamp: perforated paper, a green panel with a double frame,
// "INDIA" and a made-up denomination at the top, par avion and an airplane down the left, 郵便 and a leaf sprig down the
// right, a name band at the bottom. The portrait is a cut-out (transparent background) so the panel, the halo and the
// scenery behind it follow light and dark mode. Only the portrait itself keeps its colours. One SVG in a 100 x 114
// box so everything scales together. Colours are the --stamp-* tokens in tokens.css.
import { site } from '../data/site';
interface Props { src?: string; alt?: string; role?: string; est?: string; caption?: string; value?: string; class?: string; }
const { src, alt = '', role = 'Designer', est = '1996', caption, value = '', class: cls = '' } = Astro.props;
const [first, ...rest] = site.name.toUpperCase().split(' ');
const last = rest.join(' ');
---
<div class:list={['stamp-shadow', cls]}>
  <div class="stamp">
    <div class="stamp__inner">
      <svg class="art" viewBox="0 0 100 114" role={src ? 'img' : undefined} aria-label={src ? alt : undefined} aria-hidden={src ? undefined : 'true'} focusable="false">
        <!-- panel and halo -->
        <rect class="panel" x="0" y="0" width="100" height="114" />
        <circle class="halo" cx="49.8" cy="45.8" r="39.9" />

        <!-- scenery behind the portrait: a cloud, mountains, a leaf sprig, in one colour that reads on both the halo and the panel -->
        <defs>
          <g id="stamp-scenery" fill="currentColor">
            <path d="M16.4 62.4 C16.2 59.8 19 58.4 21.2 59.8 C21.8 56.8 26.6 56.4 27.8 59.4 C30.4 58.8 32.4 60.4 31.8 62.4 Z" fill="none" stroke="currentColor" stroke-width="0.5" />
            <path d="M1.2 74.8 L10 66.2 L13.6 69.6 L17.8 66.6 L26.4 74.8 Z" />
            <path d="M91.4 79 C91 70 90.6 62 90.2 54" fill="none" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" />
            <path d="M90.2 54 C87.6 51 88.2 47.4 91 45.6 C93.4 48 93.2 51.6 90.2 54Z" />
            <path d="M90.4 60 C86.4 59.6 84.4 56.4 85.2 53.2 C88.8 53.4 90.8 56.4 90.4 60Z" />
            <path d="M90.6 66 C94.6 65 96.8 61.8 96.4 58.4 C92.8 58.8 90.4 62.2 90.6 66Z" />
            <path d="M90.8 72 C86.8 72.2 84.6 69.2 84.8 66 C88.6 65.8 91 68.6 90.8 72Z" />
            <path d="M91 76 C94.6 76 96.8 73.2 96.6 70 C93.2 69.8 91 72.6 91 76Z" />
          </g>
        </defs>
        <use href="#stamp-scenery" class="scene" />

        <!-- the portrait (a cut-out), or a plain landscape when there is none -->
        {src ? (
          <image href={src} x="-5.8" y="0" width="111.6" height="111.6" preserveAspectRatio="xMidYMid slice" />
        ) : (
          <g>
            <path class="mtn" d="M0 70 C14 58 28 62 42 70 S72 66 100 58 V114 H0Z" opacity="0.6" />
            <path class="mtn" d="M0 84 C20 72 42 82 64 80 S90 76 100 78 V114 H0Z" />
          </g>
        )}

        <!-- name band: edge to edge under the frame lines -->
        <rect class="band" x="0" y="94.6" width="100" height="19.4" />

        <!-- double frame -->
        <rect class="line" x="0.8" y="0.8" width="98.4" height="112.4" stroke-width="0.7" />
        <rect class="line" x="2.4" y="2.4" width="95.2" height="109.2" stroke-width="0.35" />

        <!-- top left: INDIA, top right: the denomination -->
        <text class="t" x="6" y="10.6" font-size="6.6" letter-spacing="0.9">INDIA</text>
        <path class="line" d="M6 14.2 H14.6" stroke-width="0.5" />
        <text class="t" x="94.2" y="12.4" font-size="9.4" text-anchor="end">₹05</text>
        <path class="line" d="M86.6 16.2 H94.2" stroke-width="0.5" />

        <!-- left: airplane, a short line, PAR AVION up the side -->
        <path class="fill" transform="translate(8 25) scale(1.05)" d="M0 -4 C0.7 -4 1 -3.2 1 -2.4 L1 -1 L4.2 1.2 L4.2 2.2 L1 1.3 L0.9 2.8 L2 3.6 L2 4.2 L0 3.7 L-2 4.2 L-2 3.6 L-0.9 2.8 L-1 1.3 L-4.2 2.2 L-4.2 1.2 L-1 -1 L-1 -2.4 C-1 -3.2 -0.7 -4 0 -4Z" />
        <path class="line" d="M8 31 V38.6" stroke-width="0.5" />
        <text class="t" font-size="4.3" letter-spacing="0.8" text-anchor="middle" transform="translate(8.4 52.6) rotate(-90)">PAR AVION</text>

        <!-- right: 郵便 stacked, a short line -->
        <text class="t" x="92.4" y="27.4" font-size="5.6" text-anchor="middle" lang="ja" style="font-family:var(--font-jp)">郵</text>
        <text class="t" x="92.4" y="33.6" font-size="5.6" text-anchor="middle" lang="ja" style="font-family:var(--font-jp)">便</text>
        <path class="line" d="M92.4 38.2 V47" stroke-width="0.5" />

        <!-- name band content -->
        {caption ? (
          <>
            <text class="t" x="6" y="106.6" font-size="7.4" letter-spacing="0.8">{caption.toUpperCase()}</text>
            <text class="t" x="60" y="106.6" font-size="7.4" letter-spacing="0.8">{value}</text>
          </>
        ) : (
          <>
            <text class="t" x="6" y="102.6" font-size="5.9" letter-spacing="0.7">{first}</text>
            <text class="t" x="6" y="108.8" font-size="5.9" letter-spacing="0.7">{last}</text>
            <path class="line" d="M49.4 98.8 V108.6" stroke-width="0.45" />
            <text class="t" x="54.6" y="103.2" font-size="4.3" letter-spacing="0.6">{role.toUpperCase()}</text>
            <text class="t" x="54.6" y="108" font-size="3.6" letter-spacing="0.6" opacity="0.85">EST. {est}</text>
          </>
        )}
        <circle class="sun" cx="93.6" cy="99.2" r="1.6" />
        <path class="mtnline" d="M80.6 109 L85.4 103.2 L87.8 105.8 L90.2 103.8 L95.4 109 M83 109 H95.4" stroke-width="0.5" stroke-linejoin="round" />
      </svg>
    </div>
  </div>
</div>
<style>
  /* everything but the portrait follows the theme (tokens.css) */
  .stamp-shadow { filter: drop-shadow(0 0 0.55px var(--stamp-edge)) drop-shadow(0 0 0.55px var(--stamp-edge)) drop-shadow(var(--shadow-stamp)); } /* a fine edge that follows the perforation */
  .stamp { background: var(--stamp-paper); color: var(--stamp-ink); padding: calc(var(--perf-pitch) * 1.05); }
  .stamp__inner { position: relative; outline: none; aspect-ratio: 100 / 114; overflow: hidden; }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .panel { fill: var(--stamp-panel); }
  .halo { fill: var(--stamp-halo); }
  .band { fill: var(--stamp-band); }
  .line { fill: none; stroke: var(--stamp-ink); opacity: 0.85; }
  .mtnline { fill: none; stroke: var(--stamp-band-detail); }
  .t { fill: var(--stamp-ink); font-family: var(--font-mono); font-weight: 400; }
  .fill { fill: var(--stamp-ink); }
  .sun { fill: var(--stamp-band-detail); }
  .scene { color: var(--stamp-scene); }
  .mtn { fill: var(--stamp-detail); opacity: 0.7; }
</style>
