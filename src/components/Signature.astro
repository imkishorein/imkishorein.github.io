---
// Kishore's signature. Each stroke is a filled shape with pen pressure built in (thick on the downstrokes, hairline on
// the upstrokes and tapering at both ends, like a pointed pen), slanted and written fast. The ink is currentColor, so it
// follows the theme. To let it write itself, every stroke is revealed by a mask whose centreline is drawn on, one stroke
// after another in the order a pen would make them: K stem, K arm and leg, "ishore" in one running line ending in a flourish,
// the dot on the i, the underline swoosh, then a little doodle. The doodle is one of six (heart, paper plane, star, sprout,
// smiley, lantern), picked at random on each page load and never the same one twice in a row. Without JavaScript the heart
// shows. Without JavaScript, or with reduced motion, the strokes are simply shown as is.
interface Props { class?: string; id?: string; }
const { class: cls = '', id = 'sig' } = Astro.props;
