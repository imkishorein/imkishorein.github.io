<script>
  // Hide the strokes only once JS is running, then write them when the signature is about 60% in view.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<SVGElement>('[data-signature]').forEach((sig) => {
    // pick today's doodle: random, but never the one shown on the previous load in this tab
    const doodles = [...sig.querySelectorAll<SVGGElement>('[data-doodle]')];
    if (doodles.length > 1) {
      let last = -1;
      try { last = Number(sessionStorage.getItem('imk:doodle') ?? -1); } catch { /* private mode */ }
      const pool = doodles.map((_, i) => i).filter((i) => i !== last);
      const pick = pool[Math.floor(Math.random() * pool.length)];
      doodles.forEach((g, i) => g.toggleAttribute('data-on', i === pick));
      try { sessionStorage.setItem('imk:doodle', String(pick)); } catch { /* private mode */ }
    }
    if (reduce || !('IntersectionObserver' in window)) return;
    sig.setAttribute('data-draw', '');
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      sig.classList.add('in'); io.disconnect();
    }, { threshold: 0.6 });
    io.observe(sig);
  });
</script>
<style>
  .signature { display: block; width: 15rem; max-width: 100%; height: auto; overflow: visible; color: var(--color-text); }
  .signature[data-draw] mask path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .signature[data-draw].in mask path { animation: sig-write var(--t) cubic-bezier(0.45, 0.05, 0.35, 1) var(--d) forwards; }
  .signature [data-doodle]:not([data-on]) { display: none; }
  @keyframes sig-write { to { stroke-dashoffset: 0; } }
</style>
