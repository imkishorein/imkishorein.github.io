---
// Hand-drawn, animated weather icon for the hero "here" note. One inline SVG holds every icon; the
// live script sets data-kind (sun, moon, partly, moonCloud, overcast, rain, drizzle, snow, storm, fog)
// and CSS shows that one. Two looks share the same shapes, picked with the variant prop:
//   outline  : wobbly ink outlines with light fills (the first version, kept)
//   duotone  : flat filled shapes in two tones, ink and sage (the hero uses this)
// Colours come from tokens. Animations (turning rays, drifting clouds, falling rain and snow, flashing
// bolt, sliding fog, twinkling stars) are off under reduced motion.
// Note: animated parts are written inline, not through <use>, because CSS animations do not run inside <use>.
interface Props { variant?: 'outline' | 'duotone'; }
const { variant = 'duotone' } = Astro.props;

const CLOUD = 'M12 34 C6.5 34.6 5 28.5 9.5 26.6 C9 21 15.5 17.4 20.5 20 C22.5 13.4 32 13.4 33.6 20.6 C39 19.4 43.2 24 40.6 28.6 C44 30.6 42 34.6 37 34 C29 34.8 20 33.4 12 34 Z';
const SUN = 'M24 16.2 C28.6 15.8 32.2 19.6 31.8 24.2 C31.4 28.6 27.8 32.2 23.6 31.8 C19.2 31.4 16 27.6 16.3 23.8 C16.6 19.4 19.8 16.5 24 16.2 Z';
const MOON = 'M30 9 C21 10 15 18.6 17 27.6 C19 36.6 29 41 37.4 36.6 C28.4 35.6 23 27.6 26 19.6 C27.2 15.6 28.6 11.6 30 9 Z';
const rays = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4;
  const [r1, r2] = i % 2 ? [12.5, 16.5] : [12, 18];
  return `<line class="ray" x1="${(24 + r1 * Math.cos(a)).toFixed(1)}" y1="${(24 + r1 * Math.sin(a)).toFixed(1)}" x2="${(24 + r2 * Math.cos(a)).toFixed(1)}" y2="${(24 + r2 * Math.sin(a)).toFixed(1)}" />`;
}).join('');
const sun = `<g class="rays">${rays}</g><path class="sun-disc" d="${SUN}" />`;
const moon = `<path class="moon" d="${MOON}" />`;
const stars = '<g class="stars"><path class="star s1" d="M37 11 v6 M34 14 h6" /><path class="star s2" d="M41 25 v4 M39 27 h4" /><path class="star s3" d="M12 12 v3.6 M10.2 13.8 h3.6" /></g>';
const cloud = (cls = 'c') => `<path class="${cls}" d="${CLOUD}" />`;
---
<svg class={`wx wx--${variant}`} viewBox="0 0 48 48" aria-hidden="true" focusable="false" data-wx-icon>
  <g data-for="sun"><Fragment set:html={sun} /></g>

  <g data-for="moon"><Fragment set:html={moon + stars} /></g>

  <g data-for="partly">
    <g transform="translate(3 2) scale(0.66)"><Fragment set:html={sun} /></g>
    <g transform="translate(7 9) scale(0.86)"><g class="drift"><Fragment set:html={cloud()} /></g></g>
  </g>

  <g data-for="moonCloud">
    <g transform="translate(2 1) scale(0.72)"><Fragment set:html={moon} /></g>
    <g transform="translate(-2 -1) scale(0.8)"><Fragment set:html={stars} /></g>
    <g transform="translate(7 9) scale(0.86)"><g class="drift"><Fragment set:html={cloud()} /></g></g>
  </g>

  <g data-for="overcast">
    <g transform="translate(8 -9) scale(0.76)"><g class="drift-back"><Fragment set:html={cloud('c2')} /></g></g>
    <g transform="translate(0 4) scale(0.9)"><g class="drift"><Fragment set:html={cloud()} /></g></g>
  </g>

  <g data-for="rain">
    <g transform="translate(0 -5)"><g class="drift"><Fragment set:html={cloud()} /></g></g>
    <g class="drops"><path class="d d1" d="M15 34 l-2 5" /><path class="d d2" d="M23 34 l-2 5" /><path class="d d3" d="M31 34 l-2 5" /><path class="d d4" d="M39 34 l-2 5" /></g>
  </g>

  <g data-for="drizzle">
    <g transform="translate(0 -5)"><g class="drift"><Fragment set:html={cloud()} /></g></g>
    <g class="drops fine"><circle class="d d1" cx="15" cy="36" r="1.4" /><circle class="d d3" cx="23" cy="36" r="1.4" /><circle class="d d2" cx="31" cy="36" r="1.4" /><circle class="d d4" cx="38" cy="36" r="1.4" /></g>
  </g>

  <g data-for="snow">
    <g transform="translate(0 -5)"><g class="drift"><Fragment set:html={cloud()} /></g></g>
    <g class="flakes"><circle class="f f1" cx="15" cy="35" r="1.9" /><circle class="f f2" cx="24" cy="35" r="1.9" /><circle class="f f3" cx="33" cy="35" r="1.9" /></g>
  </g>

  <g data-for="storm">
    <g transform="translate(0 -6)"><g class="drift"><Fragment set:html={cloud('c3')} /></g></g>
    <path class="bolt" d="M27 28 L20 38 L25 38 L22 46 L32 35 L27 35 L30 28 Z" />
    <g class="drops"><path class="d d1" d="M13 33 l-2 5" /><path class="d d3" d="M38 33 l-2 5" /></g>
  </g>

  <g data-for="fog">
    <g class="fogline fl1"><path d="M9 15 C14 13.6 20 16 26 14.6 S36 14 40 15.4" /></g>
    <g class="fogline fl2"><path d="M6 23 C12 21.6 18 24 25 22.6 S35 22 42 23.4" /></g>
    <g class="fogline fl3"><path d="M10 31 C15 29.6 22 32 28 30.6 S37 30 41 31.4" /></g>
    <g class="fogline fl4"><path d="M8 39 C13 37.6 19 40 25 38.6 S34 38 40 39.4" /></g>
  </g>
</svg>
<style is:global>
  .wx { width: 2.15rem; height: 2.15rem; flex: none; overflow: visible; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .wx [data-for] { display: none; }
  .wx[data-kind="sun"] [data-for="sun"], .wx[data-kind="moon"] [data-for="moon"], .wx[data-kind="partly"] [data-for="partly"], .wx[data-kind="moonCloud"] [data-for="moonCloud"],
  .wx[data-kind="overcast"] [data-for="overcast"], .wx[data-kind="rain"] [data-for="rain"], .wx[data-kind="drizzle"] [data-for="drizzle"],
  .wx[data-kind="snow"] [data-for="snow"], .wx[data-kind="storm"] [data-for="storm"], .wx[data-kind="fog"] [data-for="fog"] { display: inline; }

  /* ── outline variant: ink outlines, light fills ── */
  .wx--outline { stroke: var(--color-text); stroke-width: 1.7; }
  .wx--outline .sun-disc, .wx--outline .moon { fill: var(--color-accent); }
  .wx--outline .c { fill: var(--color-surface); }
  .wx--outline .c2 { fill: var(--color-surface-sunken); }
  .wx--outline .c3 { fill: var(--color-surface-sunken); }
  .wx--outline .d { stroke: var(--color-accent-ink); }
  .wx--outline .drops.fine .d { fill: var(--color-accent-ink); stroke: none; }
  .wx--outline .f { fill: var(--color-surface); stroke-width: 1.2; }
  .wx--outline .bolt { fill: var(--color-accent); }
  .wx--outline .fogline path { stroke-width: 2; }
  .wx--outline .star { stroke-width: 1.3; }

  /* ── duotone variant: flat shapes in ink and sage, no outlines ── */
  .wx--duotone { stroke: none; }
  .wx--duotone .c, .wx--duotone .c3 { fill: var(--color-text); }
  .wx--duotone .c2 { fill: var(--color-accent); }
  .wx--duotone .sun-disc, .wx--duotone .moon { fill: var(--color-accent); }
  .wx--duotone .ray { stroke: var(--color-text); stroke-width: 2.6; }
  .wx--duotone .star { stroke: var(--color-text); stroke-width: 1.8; }
  .wx--duotone .d { stroke: var(--color-accent); stroke-width: 2.4; }
  .wx--duotone .drops.fine .d { fill: var(--color-accent); stroke: none; }
  .wx--duotone .f { fill: var(--color-accent); }
  .wx--duotone .bolt { fill: var(--color-accent); }
  .wx--duotone .fogline path { stroke: var(--color-text); stroke-width: 3; }
  .wx--duotone .fl2 path, .wx--duotone .fl4 path { stroke: var(--color-accent); }

  .wx .rays, .wx .sun-disc, .wx .moon, .wx .drift, .wx .drift-back, .wx .d, .wx .f, .wx .bolt, .wx .fogline, .wx .star { transform-box: fill-box; transform-origin: center; }

  @media (prefers-reduced-motion: no-preference) {
    .wx .rays { animation: wx-spin 14s linear infinite; }
    .wx .sun-disc { animation: wx-breathe 3s ease-in-out infinite; }
    .wx .moon { animation: wx-bob 5s ease-in-out infinite alternate; }
    .wx .drift { animation: wx-drift 4.5s ease-in-out infinite alternate; }
    .wx .drift-back { animation: wx-drift 6s ease-in-out infinite alternate-reverse; }
    .wx .d { animation: wx-fall 0.95s linear infinite; }
    .wx .d2 { animation-delay: -0.25s; } .wx .d3 { animation-delay: -0.5s; } .wx .d4 { animation-delay: -0.75s; }
    .wx .drops.fine .d { animation-duration: 1.6s; }
    .wx .f { animation: wx-snow 2.4s ease-in-out infinite; }
    .wx .f2 { animation-delay: -0.8s; } .wx .f3 { animation-delay: -1.6s; }
    .wx .bolt { animation: wx-flash 2.8s steps(1, end) infinite; }
    .wx .fogline { animation: wx-slide 3.8s ease-in-out infinite alternate; }
    .wx .fl2 { animation-delay: -1s; animation-direction: alternate-reverse; } .wx .fl3 { animation-delay: -2s; } .wx .fl4 { animation-delay: -2.9s; animation-direction: alternate-reverse; }
    .wx .star { animation: wx-twinkle 1.8s ease-in-out infinite; }
    .wx .s2 { animation-delay: -0.6s; } .wx .s3 { animation-delay: -1.2s; }
  }
  @keyframes wx-spin { to { transform: rotate(360deg); } }
  @keyframes wx-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  @keyframes wx-bob { from { transform: translateY(-1.2px) rotate(-3deg); } to { transform: translateY(1.2px) rotate(3deg); } }
  @keyframes wx-drift { from { transform: translateX(-3.5px); } to { transform: translateX(3.5px); } }
  @keyframes wx-fall { 0% { transform: translateY(-3px); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(8px); opacity: 0; } }
  @keyframes wx-snow { 0% { transform: translate(-2px, -3px); opacity: 0; } 25% { opacity: 1; } 50% { transform: translate(2px, 2.5px); } 100% { transform: translate(-1.5px, 9px); opacity: 0; } }
  @keyframes wx-flash { 0%, 55%, 100% { opacity: 1; } 60% { opacity: 0.1; } 66% { opacity: 1; } 72% { opacity: 0.1; } 78% { opacity: 1; } }
  @keyframes wx-slide { from { transform: translateX(-4px); opacity: 0.55; } to { transform: translateX(4px); opacity: 1; } }
  @keyframes wx-twinkle { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.15; transform: scale(0.6); } }
</style>
